{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Shared by every GOV.UK Forms repo. Dependabot keeps everything else up to
  // date, so Renovate only handles pins that are duplicated and have to move
  // together. Extend it as
  // `github>govuk-forms/forms-deploy//.github/renovate-shared.json5`, with the
  // extension spelled out.
  enabledManagers: ["ruby-version", "dockerfile", "terraform", "terraform-version", "mise", "github-actions", "pre-commit", "custom.regex"],
  // The pre-commit manager is off unless it is switched on as well as listed.
  "pre-commit": { enabled: true },
  minimumReleaseAge: "7 days",
  // Without this a release with no timestamp counts as old enough.
  minimumReleaseAgeBehaviour: "timestamp-required",
  // Renovate logs a package whose last release is older than this as abandoned.
  // It only logs, at debug level, and docker images have no release dates to
  // measure.
  abandonmentThreshold: "1 year",
  internalChecksFilter: "strict",
  // So a schedule slot doesn't move an hour when the clocks change.
  timezone: "Europe/London",
  dependencyDashboard: true,
  prConcurrentLimit: 5,
  // The default of two an hour delays a dashboard tick on top of the concurrent
  // limit.
  prHourlyLimit: 0,
  // Dependabot's label, so both bots' pull requests share it.
  labels: ["dependencies"],

  // When more than one rule sets the same option, the last matching rule wins,
  // so keep the general rules above the specific ones.
  //
  // Use the same group names in every repo, so the pull request title and
  // branch match.
  packageRules: [
    // Dependabot's titles. Each manager sets its own wording, which a setting
    // at the top would lose to.
    {
      matchPackageNames: ["*"],
      commitMessageAction: "Bump",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "from {{currentVersion}} to {{newVersion}}",
    },
    { matchDatasources: ["docker"], addLabels: ["docker"] },
    { matchManagers: ["mise", "pre-commit"], addLabels: ["tools"] },

    // Images on ECR and ghcr have no release dates, so the age check can't hold
    // them back and is turned off for them. These only get a pull request once
    // someone has checked the release date upstream and ticked the update in the
    // dashboard. Renovate sets no renovate/stability-days status on these, so
    // the label is how the release age check tells them from a missing status.
    //
    // This matches the name Renovate looks an image up by. Images that we pull
    // from ECR or ghcr but look up on Docker Hub (see renovate.json5) are named
    // after Docker Hub, so they don't match. They have dates, and open a pull
    // request on their own once the update is 7 days old.
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["public.ecr.aws/**", "ghcr.io/**"],
      minimumReleaseAge: null,
      dependencyDashboardApproval: true,
      addLabels: ["no-release-date"],
    },
    // Docker Hub images keep the age check. If Renovate can't get their dates,
    // the update waits under "Pending Status Checks" in the dashboard.

    // Dependabot keeps every GitHub Action up to date, except the jactionlint one,
    // which moves with the other jactionlint pins.
    { matchManagers: ["github-actions"], matchPackageNames: ["!jdx/jactionlint"], enabled: false },

    // Dependabot owns the providers until we have seen how Renovate treats the
    // lock files, which list five platforms.
    { matchManagers: ["terraform"], matchPackageNames: ["!hashicorp/terraform"], enabled: false },
    { matchPackageNames: ["hashicorp/terraform"], groupName: "Terraform", addLabels: ["terraform"] },
    // A major release changes what every root's plan reports, so it should be a
    // deliberate change.
    { matchPackageNames: ["hashicorp/terraform"], matchUpdateTypes: ["major"], enabled: false },

    // .ruby-version and the Dockerfile base image move together. Lambda runtimes
    // are pinned to a minor version, so only patch releases are automatic.
    { matchPackageNames: ["ruby"], groupName: "Ruby", addLabels: ["ruby"] },
    { matchPackageNames: ["ruby"], matchUpdateTypes: ["major", "minor"], enabled: false },
  ],
}
