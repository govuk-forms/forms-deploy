{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Dependabot keeps actions, bundler, terraform and the other pre-commit hooks
  // up to date. Renovate only handles the pins Dependabot can't see, and the
  // pins that are duplicated across files, which have to move together.
  enabledManagers: ["mise", "custom.regex", "terraform", "terraform-version"],
  minimumReleaseAge: "7 days",

  // One pull request per tool, so every copy of a pin changes together and
  // the versions-in-sync check passes.
  packageRules: [
    // Only the required_version in the real versions.tf files. Dependabot owns
    // the providers in them, and the other versions.tf files are symlinks.
    { matchManagers: ["terraform"], matchPackageNames: ["!hashicorp/terraform"], enabled: false },
    {
      matchManagers: ["terraform"],
      matchFileNames: ["!infra/shared/versions.tf", "!infra/deployments/forms/dns/versions.tf"],
      enabled: false,
    },
    { matchPackageNames: ["hashicorp/terraform"], groupName: "Terraform" },
    { matchPackageNames: ["terraform-linters/tflint"], groupName: "tflint" },
    { matchPackageNames: ["checkov"], groupName: "checkov" },
    { matchPackageNames: ["jdx/jactionlint"], groupName: "jactionlint" },
    { matchPackageNames: ["tmccombs/hcl2json"], groupName: "hcl2json" },
    { matchPackageNames: ["public.ecr.aws/codebuild/**"], groupName: "CodeBuild images" },
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.pre-commit-config\\.yaml$/"],
      matchStrings: ["github\\.com/terraform-linters/tflint@(?<currentValue>v[\\d.]+)"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "terraform-linters/tflint",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.pre-commit-config\\.yaml$/"],
      matchStrings: ["checkov==(?<currentValue>[\\d.]+)"],
      datasourceTemplate: "pypi",
      depNameTemplate: "checkov",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.pre-commit-config\\.yaml$/"],
      matchStrings: ["repo: https://github\\.com/jdx/jactionlint\\s+rev: (?<currentValue>v[\\d.]+)"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "jdx/jactionlint",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/reusable-lint-workflows\\.yml$/"],
      matchStrings: ["JACTIONLINT_VERSION: \"(?<currentValue>[\\d.]+)\""],
      datasourceTemplate: "github-releases",
      depNameTemplate: "jdx/jactionlint",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^infra/modules/drift-detection/main\\.tf$/"],
      matchStrings: ["HCL2JSON_VERSION=\\\\\"(?<currentValue>v[\\d.]+)\\\\\""],
      datasourceTemplate: "github-releases",
      depNameTemplate: "tmccombs/hcl2json",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^infra/.*\\.tf$/"],
      matchStrings: ["\"(?<depName>(?:public\\.ecr\\.aws|docker\\.io)/[\\w./-]+):(?<currentValue>v?\\d[\\w.-]*)\""],
      datasourceTemplate: "docker",
    },
    {
      // CodeBuild images are published to the public ECR "codebuild" namespace.
      customType: "regex",
      managerFilePatterns: ["/^infra/.*\\.tf$/"],
      matchStrings: ["\"aws/codebuild/(?<image>[\\w-]+):(?<currentValue>[\\d.]+)\""],
      datasourceTemplate: "docker",
      depNameTemplate: "aws/codebuild/{{{image}}}",
      packageNameTemplate: "public.ecr.aws/codebuild/{{{image}}}",
    },
  ],
}
